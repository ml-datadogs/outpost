# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# Aeza REST API key (https://my.aeza.net -> API). Hourly billing supported.
AEZA_API_KEY=

# Zomro form-API session token (https://api.zomro.com). See README for how to mint one.
ZOMRO_AUTH=

# ---------------------------------------------------------------------------
# SSH key used to bootstrap freshly provisioned nodes.
# The public key is uploaded to the provider at order time; the private key
# is used by the bootstrapper to install sing-box over SSH.
# ---------------------------------------------------------------------------
OUTPOST_SSH_PUBLIC_KEY_FILE=~/.ssh/outpost_ed25519.pub
OUTPOST_SSH_PRIVATE_KEY_FILE=~/.ssh/outpost_ed25519

# ---------------------------------------------------------------------------
# Subscription distribution (Cloudflare Worker)
# ---------------------------------------------------------------------------
# Secret token embedded in the subscription URL path: https://<worker>/<TOKEN>/surge
OUTPOST_SUB_TOKEN=
# Optional: base domain used for TLS SNI on Trojan/Reality (leave blank for self-signed).
OUTPOST_TLS_DOMAIN=

# ---------------------------------------------------------------------------
# SOPS / age encryption for state/inventory.enc.yaml (optional but recommended)
# ---------------------------------------------------------------------------
# Path to the age private key used by sops to decrypt the inventory.
SOPS_AGE_KEY_FILE=~/.config/sops/age/outpost.key

# ---------------------------------------------------------------------------
# Local network parameters for the on-Mac reachability probe (route bypass).
# Discover with:  route -n get default | grep gateway
# ---------------------------------------------------------------------------
OUTPOST_LAN_GATEWAY=192.168.1.1
OUTPOST_LAN_DNS=192.168.1.1
