# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# Aeza REST API key (https://my.aeza.net -> API). Hourly billing supported.
AEZA_API_KEY=

# Zomro form-API session token (https://api.zomro.com). See README for how to mint one.
ZOMRO_AUTH=

# --- Hostkey: PARKED (registry policy_ok=false). Leave blank unless re-enabling.
# Hostkey InvAPI account key (https://invapi.hostkey.ru -> Username -> API keys).
# Works once you have at least one active server; otherwise use email/password below.
HOSTKEY_API_KEY=
# Optional: override traffic plan / billing endpoint if auto-discovery fails.
# Find traffic plan id in Invapi order UI (Network step) or Hostkey docs.
# HOSTKEY_TRAFFIC_PLAN=37
# HOSTKEY_DEPLOY_OPTIONS=whmcs_itb
HOSTKEY_EMAIL=
HOSTKEY_PASSWORD=
# Optional: override InvAPI base URL (default https://invapi.hostkey.ru).
# HOSTKEY_BASE_URL=https://invapi.hostkey.ru

# ---------------------------------------------------------------------------
# SSH key used to bootstrap freshly provisioned nodes.
# The public key is uploaded to the provider at order time; the private key
# is used by the bootstrapper to install sing-box over SSH.
# ---------------------------------------------------------------------------
OUTPOST_SSH_PUBLIC_KEY_FILE=~/.ssh/outpost_ed25519.pub
OUTPOST_SSH_PRIVATE_KEY_FILE=~/.ssh/outpost_ed25519

# ---------------------------------------------------------------------------
# Subscription distribution (Cloudflare Worker)
# ---------------------------------------------------------------------------
# Secret token embedded in the subscription URL path: https://<worker>/<TOKEN>/surge
OUTPOST_SUB_TOKEN=
# Per-node DNS + real certs (recommended; see docs/dns-tls.md). Each node gets
# "<prefix>-<id>.<zone>" and its own Let's Encrypt cert. Token needs Zone:DNS:Edit
# + Zone:Zone:Read scoped to this zone only.
OUTPOST_DNS_ZONE=
CLOUDFLARE_API_TOKEN=
# OUTPOST_DNS_PREFIX=exit

# Legacy single-domain mode, used only when OUTPOST_DNS_ZONE is empty. One domain
# can cover just one node, so the rest fall back to self-signed certs.
OUTPOST_TLS_DOMAIN=

# ---------------------------------------------------------------------------
# SOPS / age encryption for state/inventory.enc.yaml (optional but recommended)
# ---------------------------------------------------------------------------
# Path to the age private key used by sops to decrypt the inventory.
SOPS_AGE_KEY_FILE=~/.config/sops/age/outpost.key

# ---------------------------------------------------------------------------
# Local network parameters for the on-Mac reachability probe (route bypass).
# Discover with:  route -n get default | grep gateway
# ---------------------------------------------------------------------------
OUTPOST_LAN_GATEWAY=192.168.1.1
OUTPOST_LAN_DNS=192.168.1.1
